// FXAA (after NVIDIA's FXAA 3.11 quality algorithm, written for this port): finds the edge's direction and ends, then moves the
// pixel's sample half way across the edge. Works on the display buffer in its encoded (perceptual) values.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;  // the sRGB view: decoded on fetch
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { vec2 inv; ivec2 size; } p;

vec3 Enc(vec3 c) { return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }
vec3 Fetch(vec2 uv) { return Enc(textureLod(src, uv, 0.0).rgb); }
float Luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= p.size.x || pix.y >= p.size.y) return;
    const vec2 uv = (vec2(pix) + 0.5) * p.inv;
    const vec3 rgbM = Fetch(uv);
    const float lM = Luma(rgbM);
    const float lS = Luma(Fetch(uv + vec2(0.0, p.inv.y))), lN = Luma(Fetch(uv - vec2(0.0, p.inv.y)));
    const float lW = Luma(Fetch(uv - vec2(p.inv.x, 0.0))), lE = Luma(Fetch(uv + vec2(p.inv.x, 0.0)));
    const float mx = max(lM, max(max(lS, lN), max(lW, lE))), mn = min(lM, min(min(lS, lN), min(lW, lE)));
    const float range = mx - mn;
    if (range < max(0.0312, mx * 0.125)) { imageStore(dst, pix, vec4(rgbM, 1.0)); return; }

    const float lNW = Luma(Fetch(uv + vec2(-p.inv.x, -p.inv.y))), lNE = Luma(Fetch(uv + vec2(p.inv.x, -p.inv.y)));
    const float lSW = Luma(Fetch(uv + vec2(-p.inv.x, p.inv.y))), lSE = Luma(Fetch(uv + vec2(p.inv.x, p.inv.y)));
    const float lNS = lN + lS, lWE = lW + lE;
    const float edgeH = abs(-2.0 * lW + (lNW + lSW)) + abs(-2.0 * lM + lNS) * 2.0 + abs(-2.0 * lE + (lNE + lSE));
    const float edgeV = abs(-2.0 * lN + (lNW + lNE)) + abs(-2.0 * lM + lWE) * 2.0 + abs(-2.0 * lS + (lSW + lSE));
    const bool horz = edgeH >= edgeV;

    const float l1 = horz ? lN : lW, l2 = horz ? lS : lE;
    const float g1 = l1 - lM, g2 = l2 - lM;
    const bool first = abs(g1) >= abs(g2);
    const float scaled = 0.25 * max(abs(g1), abs(g2));
    float step_len = horz ? p.inv.y : p.inv.x;
    float avg;
    if (first) { step_len = -step_len; avg = 0.5 * (l1 + lM); } else avg = 0.5 * (l2 + lM);
    vec2 cur = uv;
    if (horz) cur.y += step_len * 0.5; else cur.x += step_len * 0.5;
    const vec2 off = horz ? vec2(p.inv.x, 0.0) : vec2(0.0, p.inv.y);
    vec2 uv1 = cur - off, uv2 = cur + off;
    float e1 = Luma(Fetch(uv1)) - avg, e2 = Luma(Fetch(uv2)) - avg;
    bool r1 = abs(e1) >= scaled, r2 = abs(e2) >= scaled;
    if (!r1) uv1 -= off;
    if (!r2) uv2 += off;
    for (int i = 0; i < 12 && !(r1 && r2); ++i) {
        if (!r1) { e1 = Luma(Fetch(uv1)) - avg; r1 = abs(e1) >= scaled; }
        if (!r2) { e2 = Luma(Fetch(uv2)) - avg; r2 = abs(e2) >= scaled; }
        if (!r1) uv1 -= off;
        if (!r2) uv2 += off;
    }
    const float d1 = horz ? uv.x - uv1.x : uv.y - uv1.y, d2 = horz ? uv2.x - uv.x : uv2.y - uv.y;
    const bool dir1 = d1 < d2;
    const float thickness = d1 + d2;
    const float pixel_off = -min(d1, d2) / thickness + 0.5;
    const bool centre_smaller = lM < avg;
    const bool correct = ((dir1 ? e1 : e2) < 0.0) != centre_smaller;
    float final_off = correct ? pixel_off : 0.0;

    const float l_avg = (1.0 / 12.0) * (2.0 * (lNS + lWE) + (lNW + lSW) + (lNE + lSE));
    const float s1 = clamp(abs(l_avg - lM) / range, 0.0, 1.0);
    const float s2 = (-2.0 * s1 + 3.0) * s1 * s1;
    final_off = max(final_off, s2 * s2 * 0.75);
    vec2 fuv = uv;
    if (horz) fuv.y += final_off * step_len; else fuv.x += final_off * step_len;
    imageStore(dst, pix, vec4(Fetch(fuv), 1.0));
}
